{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itca-mangement",
  "main": "./frontend-worker/index.ts",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}